# Monzo OAuth (create an app at developers.monzo.com)
MONZO_CLIENT_ID=oauth2client_...
MONZO_CLIENT_SECRET=mnzconf...
MONZO_REDIRECT_URI=http://localhost:7923/callback

# Database password (used by Postgres, the poller, and the rule-editor)
POSTGRES_PASSWORD=changeme

# Grafana admin password
GF_SECURITY_ADMIN_PASSWORD=changeme

# Optional Grafana service-account token (for legacy split:N annotation lookup)
GRAFANA_TOKEN=

# Poller tuning
POLL_INTERVAL_MINUTES=30
# How far back to (re)fetch transactions on each poll; the upsert deduplicates
LOOKBACK_DAYS=90
