{
  "__inputs": [
    {
      "name": "DS_POSTGRES",
      "label": "PostgreSQL",
      "description": "PostgreSQL datasource pointing at the monzo-grafana finance database",
      "type": "datasource",
      "pluginId": "postgres",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.1.0" },
    { "type": "datasource", "id": "postgres", "name": "PostgreSQL", "version": "1.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "barchart", "name": "Bar chart", "version": "" },
    { "type": "panel", "id": "piechart", "name": "Pie chart", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Amortisation splits",
        "type": "dashboard"
      }
    ]
  },
  "description": "Personal finance dashboard powered by Monzo. Transactions tagged 'internal' or 'savings' are excluded from all totals.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Income",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyGBP",
          "color": { "mode": "fixed", "fixedColor": "green" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(SUM(amount), 0) AS value\nFROM transactions\nWHERE $__timeFilter(occurred_at)\n  AND amount > 0\n  AND category NOT IN ('internal', 'savings');"
        }
      ]
    },
    {
      "id": 2,
      "title": "Spend (raw)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyGBP",
          "color": { "mode": "fixed", "fixedColor": "red" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }] }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(SUM(-amount), 0) AS value\nFROM transactions\nWHERE $__timeFilter(occurred_at)\n  AND amount < 0\n  AND category NOT IN ('internal', 'savings');"
        }
      ]
    },
    {
      "id": 3,
      "title": "Spend (smoothed)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyGBP",
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(SUM(-amount), 0) AS value\nFROM personal_spend_daily\nWHERE $__timeFilter(occurred_at)\n  AND amount < 0\n  AND category NOT IN ('internal', 'savings');"
        }
      ]
    },
    {
      "id": 4,
      "title": "Net savings (income − smoothed spend)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyGBP",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0 },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH income AS (\n  SELECT COALESCE(SUM(amount), 0) AS v\n  FROM transactions\n  WHERE $__timeFilter(occurred_at)\n    AND amount > 0\n    AND category NOT IN ('internal', 'savings')\n), spend AS (\n  SELECT COALESCE(SUM(-amount), 0) AS v\n  FROM personal_spend_daily\n  WHERE $__timeFilter(occurred_at)\n    AND amount < 0\n    AND category NOT IN ('internal', 'savings')\n)\nSELECT (income.v - spend.v) AS value FROM income, spend;"
        }
      ]
    },
    {
      "id": 5,
      "title": "Uncategorised spend",
      "description": "Spend Monzo left in 'general' or 'unknown' — candidates for categories.yaml overrides.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyGBP",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(SUM(-amount), 0) AS value\nFROM transactions\nWHERE $__timeFilter(occurred_at)\n  AND amount < 0\n  AND category IN ('general', 'unknown');"
        }
      ]
    },
    {
      "id": 6,
      "title": "Avg monthly spend",
      "description": "Average raw spend per month over the selected range. Excludes internal/savings.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyGBP",
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH monthly AS (\n  SELECT date_trunc('month', occurred_at) AS m, SUM(-amount) AS spend\n  FROM transactions\n  WHERE $__timeFilter(occurred_at)\n    AND amount < 0\n    AND category NOT IN ('internal', 'savings')\n  GROUP BY 1\n)\nSELECT COALESCE(AVG(spend), 0) AS value FROM monthly;"
        }
      ]
    },
    {
      "id": 7,
      "title": "Spend over time — raw vs smoothed",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["sum"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyGBP",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false,
            "drawStyle": "line",
            "showPoints": "auto",
            "pointSize": 5
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Raw spend" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [6, 3] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Smoothed spend" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroup(occurred_at, '1M') AS time,\n  'Raw spend' AS metric,\n  SUM(-amount) AS value\nFROM transactions\nWHERE $__timeFilter(occurred_at)\n  AND amount < 0\n  AND category NOT IN ('internal', 'savings')\nGROUP BY 1\nORDER BY 1;"
        },
        {
          "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
          "refId": "B",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroup(occurred_at, '1M') AS time,\n  'Smoothed spend' AS metric,\n  SUM(-amount) AS value\nFROM personal_spend_daily\nWHERE $__timeFilter(occurred_at)\n  AND amount < 0\n  AND category NOT IN ('internal', 'savings')\nGROUP BY 1\nORDER BY 1;"
        }
      ]
    },
    {
      "id": 8,
      "title": "Spend by category over time",
      "description": "Stacked monthly spend per category. Excludes internal/savings.",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyGBP",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroup(occurred_at, '1M') AS time,\n  category AS metric,\n  SUM(-amount) AS value\nFROM personal_spend_daily\nWHERE $__timeFilter(occurred_at)\n  AND amount < 0\n  AND category NOT IN ('internal', 'savings')\nGROUP BY 1, 2\nORDER BY 1, 2;"
        }
      ]
    },
    {
      "id": 9,
      "title": "Total spend by category",
      "type": "barchart",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 22 },
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.97,
        "barRadius": 0,
        "fullHighlight": false,
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "showLegend": false, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "xField": "category"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyGBP",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1, "fillOpacity": 80, "axisPlacement": "auto" }
        },
        "overrides": []
      },
      "transformations": [],
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT category, SUM(-amount) AS value\nFROM personal_spend_daily\nWHERE $__timeFilter(occurred_at)\n  AND amount < 0\nGROUP BY 1\nORDER BY value DESC;"
        }
      ]
    },
    {
      "id": 10,
      "title": "Top 20 merchants by spend",
      "type": "barchart",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 22 },
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.97,
        "barRadius": 0,
        "fullHighlight": false,
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "showLegend": false, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "xField": "merchant"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyGBP",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1, "fillOpacity": 80, "axisPlacement": "auto" }
        },
        "overrides": []
      },
      "transformations": [],
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT merchant, SUM(-amount) AS value\nFROM transactions\nWHERE $__timeFilter(occurred_at)\n  AND amount < 0\n  AND category NOT IN ('internal', 'savings')\nGROUP BY 1\nORDER BY value DESC\nLIMIT 20;"
        }
      ]
    },
    {
      "id": 11,
      "title": "Uncategorised transactions",
      "description": "Transactions Monzo couldn't categorise. Click a merchant to add a rule.",
      "type": "table",
      "gridPos": { "h": 10, "w": 16, "x": 0, "y": 32 },
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false, "reducer": ["sum"], "countRows": false }
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "occurred_at" },
            "properties": [
              { "id": "displayName", "value": "Date" },
              { "id": "custom.width", "value": 180 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "amount" },
            "properties": [
              { "id": "displayName", "value": "Amount" },
              { "id": "unit", "value": "currencyGBP" },
              { "id": "custom.width", "value": 110 },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 0 }]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "merchant" },
            "properties": [
              { "id": "displayName", "value": "Merchant" },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Edit rule for this transaction",
                    "url": "http://localhost:7924/new?tx_id=${__data.fields.transaction_id:percentencode}&merchant=${__value.text:percentencode}&description=${__data.fields.description:percentencode}&amount=${__data.fields.amount:percentencode}&category=${__data.fields.category:percentencode}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "description" },
            "properties": [{ "id": "displayName", "value": "Description" }]
          },
          {
            "matcher": { "id": "byName", "options": "transaction_id" },
            "properties": [
              { "id": "displayName", "value": "Tx ID" },
              { "id": "custom.width", "value": 220 }
            ]
          }
        ]
      },
      "transformations": [],
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT occurred_at, amount, merchant, description, category, id AS transaction_id\nFROM transactions\nWHERE $__timeFilter(occurred_at)\n  AND category IN ('general', 'unknown')\nORDER BY occurred_at DESC\nLIMIT 200;"
        }
      ]
    },
    {
      "id": 12,
      "title": "Category share",
      "description": "Donut of total spend by category over the selected range.",
      "type": "piechart",
      "gridPos": { "h": 10, "w": 8, "x": 16, "y": 32 },
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "pieType": "donut",
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "right", "showLegend": true, "values": ["percent"] },
        "displayLabels": ["percent"]
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyGBP",
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "rowsToFields",
          "options": {
            "mappings": [
              { "fieldName": "category", "handlerKey": "field.name" },
              { "fieldName": "value", "handlerKey": "field.value" }
            ]
          }
        }
      ],
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT category, SUM(-amount) AS value\nFROM personal_spend_daily\nWHERE $__timeFilter(occurred_at)\n  AND amount < 0\nGROUP BY 1\nORDER BY value DESC;"
        }
      ]
    },
    {
      "id": 13,
      "title": "All transactions",
      "description": "Filtered by the category dropdown above. Default 'All' shows everything including internal/savings.",
      "type": "table",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 42 },
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false, "reducer": ["sum"], "countRows": false }
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "occurred_at" },
            "properties": [
              { "id": "displayName", "value": "Date" },
              { "id": "custom.width", "value": 180 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "amount" },
            "properties": [
              { "id": "displayName", "value": "Amount" },
              { "id": "unit", "value": "currencyGBP" },
              { "id": "custom.width", "value": 110 },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 0 }]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "category" },
            "properties": [{ "id": "displayName", "value": "Category" }, { "id": "custom.width", "value": 130 }]
          },
          {
            "matcher": { "id": "byName", "options": "merchant" },
            "properties": [
              { "id": "displayName", "value": "Merchant" },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Edit rule for this transaction",
                    "url": "http://localhost:7924/new?tx_id=${__data.fields.transaction_id:percentencode}&merchant=${__value.text:percentencode}&description=${__data.fields.description:percentencode}&amount=${__data.fields.amount:percentencode}&category=${__data.fields.category:percentencode}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "description" },
            "properties": [{ "id": "displayName", "value": "Description" }]
          },
          {
            "matcher": { "id": "byName", "options": "transaction_id" },
            "properties": [
              { "id": "displayName", "value": "Tx ID" },
              { "id": "custom.width", "value": 220 }
            ]
          }
        ]
      },
      "transformations": [],
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT occurred_at, amount, category, merchant, description, id AS transaction_id\nFROM transactions\nWHERE $__timeFilter(occurred_at)\n  AND category = ANY(string_to_array('${category:csv}', ','))\nORDER BY occurred_at DESC\nLIMIT 1000;"
        }
      ]
    },
    {
      "id": 14,
      "title": "Net worth — by account",
      "description": "Daily balance per account. Monzo computed from transactions; others forward-filled from snapshots (`python poller.py snapshot ACC DATE BAL`).",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 54 },
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyGBP",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 30,
            "stacking": { "mode": "normal", "group": "A" },
