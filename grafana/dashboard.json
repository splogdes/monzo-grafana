      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT t.occurred_at, t.merchant, (t.amount * t.my_share)::numeric(12,2) AS personal, t.description,\n       CASE WHEN t.offset_for_group IS NOT NULL THEN 'reimbursement' ELSE 'spend' END AS kind\nFROM transactions t\nWHERE (t.group_id = ANY(string_to_array('${group:csv}', ','))\n    OR t.offset_for_group = ANY(string_to_array('${group:csv}', ',')))\nORDER BY t.occurred_at DESC;"
        }
